# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# To use another provider instead of Claude, set these three and leave ANTHROPIC_API_KEY empty.
# Any OpenAI-compatible chat-completions API works. Example: Google Gemini free tier.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# AGENT_MODEL=gemini-3.8-flash
# Seconds between requests, to stay under a free tier's requests-per-minute limit.
# LLM_MIN_INTERVAL=5
# How many times one request is tried. Default 2 for the chat; the eval runner uses 6.
# LLM_MAX_ATTEMPTS=2

# Required when deployed: a long random string. Signs the session cookie.
SECRET_KEY=
# When set, visitors must enter this code before they can chat. Set it on any public deployment.
DEMO_CODE=
# Set to 1 when the site is served over https.
COOKIE_SECURE=

# Optional. Defaults shown.
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# JUDGE_MODEL=claude-haiku-5-5
# DB_PATH=travel.db
# USER_DAILY_MESSAGES=30
# GLOBAL_DAILY_MESSAGES=300
